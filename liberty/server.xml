<?xml version="1.0" encoding="UTF-8"?>
<server description="EPIMS EPS Core Server">

    <featureManager>
        <feature>servlet-6.0</feature>
        <feature>monitor-1.0</feature>
    </featureManager>

    <httpEndpoint
            id="defaultHttpEndpoint"
            host="*"
            httpPort="9080"
            httpsPort="9443" />

    <webApplication
            id="epims-eps-core"
            name="epims-eps-core"
            location="epims-eps-core.war"
            contextRoot="/eps" />

</server>